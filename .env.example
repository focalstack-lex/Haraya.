# Haraya Environment Configuration Template
# Duplicate this file to .env.local and populate with your project credentials.

# Supabase API Configuration (Project: mrptyujjpltvazgjxktn)
VITE_SUPABASE_URL="https://mrptyujjpltvazgjxktn.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Application Settings
VITE_APP_TITLE="Haraya: Davao Specialty Coffee and Bean Archive"
VITE_REGION_DEFAULT="Davao City"
VITE_SITE_URL="https://www.haraya.space"

# Launch phase: unset (default) keeps the soft-launch pre-registration page on for everyone but admins.
# Set to "open" to open the app to everyone.
VITE_LAUNCH_MODE=""

# Street routing (OSRM): walking routes and road distances. Unset uses the free FOSSGIS servers
# (https://routing.openstreetmap.de/routed-foot and /routed-car). For real traffic point these at your own
# OSRM server's base URLs (the part before /route/v1) and add its host to connect-src in vercel.json.
VITE_ROUTING_FOOT_URL=""
VITE_ROUTING_CAR_URL=""
